  "license": "UNLICENSED",
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "lucide-react": "^0.562.0",
    "next": "^14.2.35",
    "next-intl": "^4.7.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.7.0",
