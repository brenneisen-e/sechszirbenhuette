{
  "name": "sechszirbenhuette",
  "version": "1.0.0",
  "description": "Premium-Hüttenurlaub in den Kärntner Nockbergen",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "pages:build": "opennextjs-cloudflare build && cp -r .open-next/cloudflare .open-next/middleware .open-next/server-functions .open-next/.build .open-next/assets/ && cp .open-next/worker.js .open-next/assets/_worker.js && cp public/_routes.json .open-next/assets/_routes.json",
    "preview": "opennextjs-cloudflare build && wrangler dev",
    "deploy": "opennextjs-cloudflare build && wrangler pages deploy .open-next/assets --project-name=sechszirbenhuette",
    "db:migrate": "wrangler d1 execute sechszirbenhuette-db --file=./db/schema.sql",
    "db:seed": "wrangler d1 execute sechszirbenhuette-db --file=./db/seed.sql"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/brenneisen-e/sechszirbenhuette"
  },
  "keywords": [
    "ferienhaus",
    "kärnten",
    "nockberge",
    "hüttenurlaub",
    "falkert"
  ],
  "author": "Malte + Mareike Brenneisen",
  "license": "UNLICENSED",
  "dependencies": {
    "@types/node": "^25.0.8",
    "@types/react": "^19.2.8",
    "autoprefixer": "^10.4.23",
    "clsx": "^2.1.1",
    "framer-motion": "^12.26.2",
    "jszip": "^3.10.1",
    "lucide-react": "^0.562.0",
    "next": "^15.0.0",
    "postcss": "^8.5.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.7.0",
    "tailwind-merge": "^3.4.0",
    "hls.js": "^1.5.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.971.0",
    "@cloudflare/workers-types": "^4.20260116.0",
    "@opennextjs/cloudflare": "^1.14.8"
  }
}
